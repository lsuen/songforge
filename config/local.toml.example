# 复制为 local.toml（已 gitignore）。clone 到任意目录后只改这里即可连本机 ComfyUI。
#
# 例：D:\CodeFiles\ProProjects\songforge
#   copy config\local.toml.example config\local.toml
#   填好下方路径 → .\.venv\Scripts\python.exe songforge.py doctor

[engine]
# ComfyUI 已启动的地址（本机默认 8188）
server = "http://127.0.0.1:8188"

[paths]
# ComfyUI 安装根（含 models/ checkpoints、loras、custom_nodes）
comfy_root = "D:/CodeFiles/Thinking/ComfyUI-MiniMaxH3"

# QC 用的 Python（需 librosa/torch/demucs；可与 CLI .venv 分离）
qc_python = "C:/comfyui-venv/Scripts/python.exe"

# 生成音频输出目录（不填则用 <comfy_root>/output/MyMusic）
music_dir = "D:/CodeFiles/Thinking/ComfyUI-MiniMaxH3/output/MyMusic"
